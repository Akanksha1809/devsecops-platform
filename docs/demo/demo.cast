{"version":3,"term":{"cols":80,"rows":24},"timestamp":1793006955,"idle_time_limit":3.0,"command":"bash demo-recording.sh","title":"DevSecOps Platform - Live Demo","env":{"SHELL":"/bin/zsh"}}
[0.029, "o", "TERM environment variable not set.\r\n"]
[0.000, "o", "\r\n# DevSecOps Platform -- live demo\r\n"]
[2.522, "o", "\r\n# 1. The app -- health and info endpoints\r\n"]
[1.508, "o", "\r\n$ kubectl -n devsecops-dev port-forward svc/devsecops-app 18900:8000 &\r\n"]
[4.220, "o", "\r\n$ curl -s http://localhost:18900/\r\n"]
[1.439, "o", "{\r\n    \u001b[1m\"name\"\u001b[0m: \u001b[32m\"devsecops-platform-app\"\u001b[0m,\r\n    \u001b[1m\"version\"\u001b[0m: \u001b[32m\"0.2.0\"\u001b[0m,\r\n    \u001b[1m\"git_sha\"\u001b[0m: \u001b[32m\"local\"\u001b[0m\r\n}\r\n"]
[0.004, "o", "\r\n$ curl -s http://localhost:18900/health\r\n"]
[1.390, "o", "{\r\n    \u001b[1m\"status\"\u001b[0m: \u001b[32m\"alive\"\u001b[0m\r\n}\r\n"]
[0.004, "o", "\r\n# 2. GitOps -- Argo CD owns every deploy, Jenkins never touches the cluster\r\n"]
[1.503, "o", "\r\n$ kubectl -n argocd get applications\r\n"]
[1.335, "o", "NAME                    SYNC STATUS   HEALTH STATUS\r\ndevsecops-app-dev       Synced        Healthy\r\ndevsecops-app-staging   OutOfSync     Missing\r\nmonitoring              Synced        Healthy\r\nvault                   Synced        Healthy\r\n"]
[0.000, "o", "\r\n# 3. Progressive delivery -- watching a real canary rollout\r\n"]
[1.509, "o", "\r\n$ kubectl argo rollouts get rollout devsecops-app -n devsecops-dev\r\n"]
[1.647, "o", "Name:            devsecops-app\r\nNamespace:       devsecops-dev\r\nStatus:          \u001b[32m✔\u001b[0m Healthy\r\nStrategy:        Canary\r\n  Step:          6/6\r\n  SetWeight:     100\r\n  ActualWeight:  100\r\nImages:          devsecops-platform-app:dev (\u001b[32mstable\u001b[0m)\r\nReplicas:\r\n  Desired:       2\r\n  Current:       2\r\n  Updated:       2\r\n  Ready:         2\r\n  Available:     2\r\n\r\n"]
