[0.008, "o", "\r\n# 4. A deliberately bad release is already pushed to Git -- triggering Argo CD to sync it now, live\r\n"]
[1.508, "o", "\r\n$ git log --oneline -1\r\n"]
[1.237, "o", "536babb (HEAD -> main, origin/main) Demo recording (final take): deliberately bad release\r\n"]
[4.439, "o", "\r\n$ argocd app sync devsecops-app-dev\r\n"]
