# Vault bootstrap: enables the secrets engine, writes one demo secret,
# and configures the Kubernetes auth method so a pod can read that
# secret using only its own ServiceAccount identity -- no static Vault
# token is ever handed to the app. Resource/attribute names here were
# checked against the actual installed provider schema
# (`terraform providers schema -json`), not assumed.
#
# This Terraform config talks to Vault through the same port-forward
# used throughout this project (VAULT_ADDR=http://localhost:18200,
# VAULT_TOKEN=<fresh root token from `kubectl -n vault logs
# deployment/vault`> set as env vars before `terraform apply` -- see
# docs/IMPLEMENTATION_PLAN.md Sec4g for the exact commands). The root
# token is never written to a file in this repo and is regenerated by
# Vault itself on every pod restart, since VAULT_DEV_ROOT_TOKEN_ID is
# deliberately left unset in vault/deployment.yaml.

# "Audit logging where supported" (brief Section L) -- the file device
# writes to the emptyDir already mounted at /vault/audit in
# vault/deployment.yaml. Every auth attempt and secret access, including
# the Kubernetes-auth login the app's initContainer performs, is logged
# here. Lost on pod restart along with everything else in dev mode --
# a real deployment would ship this to a durable sink.
resource "vault_audit" "file" {
  type = "file"
  path = "file"
  options = {
    file_path = "/vault/audit/audit.log"
  }
}

resource "vault_mount" "devsecops" {
  path = "devsecops"
  type = "kv"
  options = {
    version = "2"
  }
  description = "KV v2 secrets for the devsecops-platform demo app."
}

resource "vault_kv_secret_v2" "example" {
  mount = vault_mount.devsecops.path
  name  = "devsecops-app/example"
  data_json = jsonencode({
    example_api_key = "demo-value-not-a-real-credential"
  })
}

resource "vault_auth_backend" "kubernetes" {
  type = "kubernetes"
  path = "kubernetes"
}

# kubernetes_ca_cert comes from the well-known kube-root-ca.crt
# ConfigMap that Kubernetes creates in every namespace -- the same
# cluster CA Terraform's own kubernetes provider already trusts,
# fetched directly instead of asking the user to paste a cert by hand.
data "kubernetes_config_map" "kube_root_ca" {
  metadata {
    name      = "kube-root-ca.crt"
    namespace = "default"
  }
}

resource "vault_kubernetes_auth_backend_config" "this" {
  backend            = vault_auth_backend.kubernetes.path
  kubernetes_host    = "https://kubernetes.default.svc:443"
  kubernetes_ca_cert = data.kubernetes_config_map.kube_root_ca.data["ca.crt"]
  # token_reviewer_jwt intentionally omitted: Vault runs in-cluster and
  # its own pod's ServiceAccount (bound to system:auth-delegator in
  # vault/deployment.yaml) already has TokenReview permission, so the
  # Kubernetes auth plugin uses that automatically rather than needing a
  # separately-managed static reviewer token.
}

resource "vault_policy" "devsecops_app_read" {
  name   = "devsecops-app-read"
  policy = <<-EOT
    path "devsecops/data/devsecops-app/example" {
      capabilities = ["read"]
    }
  EOT
}

resource "vault_kubernetes_auth_backend_role" "devsecops_app" {
  backend                          = vault_auth_backend.kubernetes.path
  role_name                        = "devsecops-app"
  bound_service_account_names      = ["devsecops-app"]
  bound_service_account_namespaces = ["devsecops-dev"]
  token_policies                   = [vault_policy.devsecops_app_read.name]
  token_ttl                        = 300
}
